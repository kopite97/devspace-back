# DB_HOST: Spring Boot가 접속할 PostgreSQL 호스트
# DB_PORT: 로컬 호스트에 노출할 PostgreSQL 포트
# DB_NAME: PostgreSQL 데이터베이스 이름
# DB_USERNAME: PostgreSQL 접속 사용자 이름
# DB_PASSWORD: PostgreSQL 접속 비밀번호
# DB_URL: Spring Boot datasource JDBC URL
# OIDC_GOOGLE_CLIENT_ID: Google OIDC client ID (실제 값은 로컬 .env에만 입력)
# OIDC_GOOGLE_CLIENT_SECRET: Google OIDC client secret (실제 값은 로컬 .env에만 입력)
# OIDC_GOOGLE_ISSUER_URI: Google OIDC issuer URI, 기본값 https://accounts.google.com
# OIDC_GOOGLE_REDIRECT_URI: 애플리케이션 callback URI (예: http://localhost:8080/api/v1/auth/callback/google)
# APP_ORIGIN: 브라우저 mutation 요청에 허용할 애플리케이션 origin (예: http://localhost:8080)
# SESSION_IDLE_TIMEOUT: 표준 Servlet 세션 유휴 만료 기간, 기본값 12h
# SESSION_COOKIE_NAME: 세션 쿠키 이름 (HTTPS 운영은 __Host-devspace-session 권장)
# SESSION_COOKIE_SECURE: HTTPS 운영에서 true, 로컬 HTTP에서는 false
# PROJECT_CURSOR_SIGNING_KEY: required random secret, at least 32 UTF-8 bytes; identical across application instances.
# Rotate this key together on all instances; existing cursors become invalid and clients restart from the first page.

# Maximum admitted live Links per workspace (1..500).
DEVSPACE_LINK_MAX_LINKS=500

# Document Editor: serialized content bytes (request envelope has 64 KiB headroom).
DOCUMENT_CONTENT_MAX_BYTES=1048576

# Provision this absolute external directory with .devspace-document-storage marker first.
FILE_STORAGE_ROOT=/var/lib/devspace/document-storage
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_REQUEST_MAX_BYTES=11534336

# Cleanup and bounded content streaming defaults.
ATTACHMENT_TEMP_GRACE_SECONDS=86400
ATTACHMENT_CLEANUP_DELAY_MS=600000
ATTACHMENT_CLEANUP_BATCH_SIZE=100
ATTACHMENT_CLEANUP_ENABLED=true
ATTACHMENT_STREAM_MAX_CONCURRENT=16
ATTACHMENT_STREAM_TIMEOUT_MS=30000
